# Simulateur SEO commercial, branché sur Ma Sonate (ADR 0006 du portail, migration 0059).
# Une valeur par environnement (dev, staging, prod), posée dans Vercel. Jamais de repli.

# Projet Supabase du portail (masonate-dev, -staging ou -prod). Schéma : simulateur_seo.
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<cle-anon>
# Réservée à la route /sso (registre des tickets, journal, ouverture de la session).
SUPABASE_SERVICE_ROLE_KEY=<cle-service-role>

# Secret du ticket signé, partagé avec le portail (même nom des deux côtés). Tickets de console seulement.
SIMULATEUR_SEO_SHARED_SECRET=<secret-long-et-aleatoire>

# Où renvoyer pour se connecter et après déconnexion.
NEXT_PUBLIC_PORTAL_URL=https://ma.sonate.group
